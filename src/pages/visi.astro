---
import Base from '../layouts/Base.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
---

<Base
  title="Visi, Misi & Anggaran Dasar | Transia Career"
  description="Visi dan misi LPK Transia Career: menjadi lembaga pelatihan kerja luar negeri terpercaya yang mengantarkan generasi Indonesia berdaya saing global di Jepang."
  canonical="https://transiacareer.id/visi"
>
  <Navbar activePage="visi" />

  <section style="padding-top:110px;padding-bottom:72px;padding-left:5%;padding-right:5%;background:linear-gradient(135deg,var(--sky-pale) 0%,#fff 60%,#fff5f5 100%);position:relative;overflow:hidden;">
    <div style="position:absolute;top:-80px;right:-80px;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(59,158,208,0.07) 0%,transparent 70%);"></div>
    <div class="section-inner" style="position:relative;z-index:1;">
      <div class="section-tag">Fondasi Organisasi</div>
      <h1 class="section-title">Visi, Misi &amp; <em>Anggaran Dasar</em></h1>
      <p class="section-sub">Landasan nilai dan tata kelola yang menjadi kompas Transia Career dalam menjalankan misi mulianya.</p>

      <!-- VISI -->
      <div class="visi-misi-card fade-in" style="margin-top:56px;background:var(--white);border-radius:var(--radius-lg);padding:48px;border:1px solid var(--gray-light);box-shadow:var(--shadow-md);position:relative;overflow:hidden;">
        <div style="position:absolute;top:0;left:0;right:0;height:5px;background:linear-gradient(90deg,var(--sky),var(--sky-dark));border-radius:var(--radius-lg) var(--radius-lg) 0 0;"></div>
        <div style="position:absolute;bottom:-20px;right:-10px;font-size:8rem;font-weight:900;color:rgba(59,158,208,0.04);font-family:var(--font-display);line-height:1;pointer-events:none;">VISI</div>
        <div class="visi-flex" style="display:flex;align-items:flex-start;gap:24px;">
          <div class="visi-icon" style="width:56px;height:56px;border-radius:14px;background:var(--sky-pale);border:2px solid rgba(59,158,208,0.2);display:flex;align-items:center;justify-content:center;font-size:1.6rem;flex-shrink:0;">🔭</div>
          <div>
            <div class="section-tag" style="margin-bottom:10px;">Visi</div>
            <h2 style="font-family:var(--font-display);font-size:1.5rem;color:var(--dark);line-height:1.4;margin-bottom:16px;">"Menjadi Lembaga Pelatihan Kerja Luar Negeri Terpercaya yang Mengantarkan Generasi Indonesia Berdaya Saing Global di Jepang."</h2>
            <p style="color:var(--gray);font-size:.93rem;line-height:1.8;">Transia Career bercita-cita hadir sebagai jembatan yang kokoh antara sumber daya manusia Indonesia yang berpotensi dengan peluang karir profesional di Jepang — membangun generasi Indonesia yang tidak hanya bekerja, tetapi juga bertumbuh, berdampak, dan membawa kebanggaan bagi bangsa.</p>
          </div>
        </div>
      </div>

      <!-- MISI -->
      <div class="visi-misi-card fade-in" style="margin-top:28px;background:var(--white);border-radius:var(--radius-lg);padding:48px;border:1px solid var(--gray-light);box-shadow:var(--shadow-md);position:relative;overflow:hidden;">
        <div style="position:absolute;top:0;left:0;right:0;height:5px;background:linear-gradient(90deg,var(--red),var(--red-dark));border-radius:var(--radius-lg) var(--radius-lg) 0 0;"></div>
        <div style="position:absolute;bottom:-20px;right:-10px;font-size:8rem;font-weight:900;color:rgba(230,48,39,0.04);font-family:var(--font-display);line-height:1;pointer-events:none;">MISI</div>
        <div class="visi-flex" style="display:flex;align-items:flex-start;gap:24px;">
          <div class="visi-icon" style="width:56px;height:56px;border-radius:14px;background:#fff5f5;border:2px solid rgba(230,48,39,0.15);display:flex;align-items:center;justify-content:center;font-size:1.6rem;flex-shrink:0;">🎯</div>
          <div style="flex:1;">
            <div class="section-tag" style="margin-bottom:16px;color:var(--red);"><span style="width:20px;height:2px;background:var(--red);border-radius:2px;display:inline-block;margin-right:6px;vertical-align:middle;"></span>Misi</div>
            <div style="display:flex;flex-direction:column;gap:14px;">
              {[
                ['Menyelenggarakan Pelatihan Berkualitas', 'Menyediakan program pendidikan bahasa Jepang, pelatihan fisik, dan uji kompetensi yang terstruktur dan sesuai standar internasional.'],
                ['Memberdayakan Generasi Muda Indonesia', 'Membuka akses seluas-luasnya bagi putra-putri Indonesia, terutama dari daerah, untuk mendapatkan kesempatan berkarir di Jepang secara legal dan bermartabat.'],
                ['Menjaga Transparansi & Integritas', 'Menjalankan seluruh proses pendaftaran, pelatihan, dan penempatan dengan penuh keterbukaan, tanpa biaya tersembunyi, dan selalu mengutamakan kepentingan peserta.'],
                ['Membangun Ekosistem yang Berkelanjutan', 'Mengembangkan jaringan alumni, relasi perusahaan Jepang, dan platform digital yang mendukung pertumbuhan jangka panjang peserta dan lembaga.'],
                ['Memberikan Dampak Sosial Nyata', 'Berkontribusi pada peningkatan kesejahteraan keluarga peserta dan pengurangan angka pengangguran di daerah, khususnya wilayah Blora dan sekitarnya.'],
              ].map(([title, desc], i) => (
                <div style="display:flex;gap:14px;align-items:flex-start;padding:16px 18px;background:var(--off-white);border-radius:10px;border:1px solid var(--gray-light);">
                  <div style="width:28px;height:28px;border-radius:50%;background:var(--sky);color:white;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:800;flex-shrink:0;margin-top:1px;">{String(i+1).padStart(2,'0')}</div>
                  <p style="font-size:.92rem;color:var(--dark-mid);line-height:1.7;"><strong style="color:var(--dark);">{title}</strong> — {desc}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- NILAI INTI -->
      <div style="margin-top:28px;" class="fade-in">
        <div style="text-align:center;margin-bottom:32px;">
          <div class="section-tag" style="justify-content:center;">Nilai Inti</div>
          <h2 style="font-family:var(--font-display);font-size:1.6rem;color:var(--dark);">Core Values <em style="color:var(--sky);">Transia Career</em></h2>
        </div>
        <div class="core-values-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px;">
          {[['🤝','Integritas','Jujur, transparan, dan konsisten dalam setiap tindakan.'],['🏅','Kualitas','Mengutamakan mutu di setiap tahap proses, bukan sekadar kuantitas.'],['💡','Inovasi','Terus berkembang dengan teknologi dan metode terbaik.'],['❤️','Kepedulian','Peserta bukan sekadar klien — mereka adalah bagian dari keluarga Transia.']].map(([icon, name, desc]) => (
            <div style="background:var(--white);border-radius:var(--radius);padding:24px 20px;border:1px solid var(--gray-light);text-align:center;">
              <div style="font-size:2rem;margin-bottom:10px;">{icon}</div>
              <div style="font-weight:700;color:var(--dark);margin-bottom:6px;">{name}</div>
              <div style="font-size:.82rem;color:var(--gray);line-height:1.6;">{desc}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Base>
