---
interface Props {
  activePage?: string
}
const { activePage = '' } = Astro.props

const links = [
  { href: '/',          label: 'Beranda',   key: 'home' },
  { href: '/tentang',   label: 'Tentang',   key: 'tentang' },
  { href: '/program',   label: 'Program',   key: 'program' },
  { href: '/alur',      label: 'Alur',      key: 'alur' },
  { href: '/testimoni', label: 'Testimoni', key: 'testimoni' },
  { href: '/blog',      label: 'Blog',      key: 'blog' },
]
---

<nav id="navbar">
  <a class="nav-logo" href="/">
    <img src="/logo.png" alt="Transia Career" class="nav-logo-icon" width="38" height="38" style="object-fit:contain;">
    <span class="nav-logo-text">Transia <span>Career</span></span>
  </a>

  <ul class="nav-links">
    {links.map(l => (
      <li>
        <a href={l.href} class={activePage === l.key ? 'active' : ''}>
          {l.label}
        </a>
      </li>
    ))}
    <li><a href="https://lms.transiacareer.id" target="_blank" rel="noopener" class="nav-lms">🎓 LMS</a></li>
    <li><a href="/daftar" class="nav-cta">✍️ Daftar</a></li>
  </ul>

  <button class="hamburger" onclick="toggleMobile()" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>

<div class="mobile-menu" id="mobileMenu">
  {links.map(l => <a href={l.href}>{l.label}</a>)}
  <a href="https://lms.transiacareer.id" target="_blank" rel="noopener">🎓 Masuk LMS</a>
  <a href="/daftar" style="color: var(--red); font-weight: 700;">✍️ Daftar Sekarang</a>
</div>
