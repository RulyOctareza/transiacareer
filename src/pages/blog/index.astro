---
import Base from '../../layouts/Base.astro'
import Navbar from '../../components/Navbar.astro'
import Footer from '../../components/Footer.astro'
import { getPublishedPosts } from '../../lib/supabase'

const posts = await getPublishedPosts().catch(() => [])
const featuredPost = posts.find(p => p.is_featured) ?? posts[0]
const restPosts = posts.filter(p => p.id !== featuredPost?.id)

function fmtDate(str: string) {
  return new Date(str).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
}

const catLabels: Record<string, string> = { tips: 'Tips', berita: 'Berita', jepang: 'Info Jepang', umum: 'Umum' }

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Blog Transia Career',
  url: 'https://transiacareer.id/blog',
  numberOfItems: posts.length,
  itemListElement: posts.slice(0, 10).map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://transiacareer.id/blog/${p.slug}`,
    name: p.title,
  })),
}
---

<Base
  title="Blog & Tips Kerja ke Jepang | Transia Career"
  description="Artikel, tips, dan informasi terkini seputar bekerja di Jepang. Jalur SSW, Magang, persiapan ujian JFT, kisah alumni, dan info lowongan terbaru dari Transia Career."
  canonical="https://transiacareer.id/blog"
  jsonLd={jsonLd}
>
  <Navbar activePage="blog" />

  <section class="blog-hero">
    <div class="section-inner">
      <span class="section-tag">ARTIKEL & TIPS</span>
      <h1 class="section-title">Wawasan untuk<br><em>Perjalananmu ke Jepang</em></h1>
      <p class="section-sub" style="margin:0 auto;">Kisah nyata, tips praktis, dan informasi terkini seputar bekerja di Jepang.</p>
    </div>
  </section>

  <div class="blog-content-area">
    {posts.length === 0 ? (
      <div style="text-align:center;padding:60px;color:var(--gray);">
        <p>Belum ada artikel yang dipublikasikan.</p>
      </div>
    ) : (
      <>
        {featuredPost && (
          <a href={`/blog/${featuredPost.slug}`} class="blog-featured">
            <div class="blog-featured-img">
              {featuredPost.featured_image
                ? <img src={featuredPost.featured_image} alt={featuredPost.title} loading="eager">
                : <div style="width:100%;background:var(--sky-pale);min-height:280px;"></div>
              }
            </div>
            <div class="blog-featured-body">
              <div class="blog-featured-label">✦ Artikel Pilihan</div>
              <span class={`blog-cat-badge blog-cat-${featuredPost.category}`}>{catLabels[featuredPost.category] ?? featuredPost.category}</span>
              <h2 style="font-family:var(--font-display);font-size:1.6rem;line-height:1.25;margin:12px 0;color:var(--dark)">{featuredPost.title}</h2>
              <p style="color:var(--gray);font-size:.9rem;line-height:1.6;margin-bottom:16px;">{featuredPost.excerpt}</p>
              <div class="blog-card-meta">{fmtDate(featuredPost.published_at ?? featuredPost.created_at)}</div>
            </div>
          </a>
        )}

        {restPosts.length > 0 && (
          <div class="blog-grid">
            {restPosts.map(p => (
              <a href={`/blog/${p.slug}`} class="blog-card">
                <div class="blog-card-img">
                  {p.featured_image
                    ? <img src={p.featured_image} alt={p.title} loading="lazy">
                    : <div style="width:100%;height:100%;background:var(--sky-pale);"></div>
                  }
                </div>
                <div class="blog-card-body">
                  <span class={`blog-cat-badge blog-cat-${p.category}`}>{catLabels[p.category] ?? p.category}</span>
                  <div class="blog-card-title">{p.title}</div>
                  <div class="blog-card-excerpt">{p.excerpt}</div>
                  <div class="blog-card-meta">{fmtDate(p.published_at ?? p.created_at)}</div>
                </div>
              </a>
            ))}
          </div>
        )}
      </>
    )}
  </div>

  <Footer />
</Base>
