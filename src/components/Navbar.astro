---
interface Props {
  activePage?: string
}
const { activePage = '' } = Astro.props

const links = [
  { href: '/',          label: 'Beranda',   key: 'home' },
  { href: '/tentang',   label: 'Tentang',   key: 'tentang' },
  { href: '/program',   label: 'Program',   key: 'program' },
  { href: '/alur',      label: 'Alur',      key: 'alur' },
  { href: '/testimoni', label: 'Testimoni', key: 'testimoni' },
  { href: '/blog',      label: 'Blog',      key: 'blog' },
]
---

<nav id="navbar">
  <a class="nav-logo" href="/">
    <svg class="nav-logo-icon" width="38" height="38" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <g stroke="#F4A62A" stroke-width="6" stroke-linecap="round">
        <line x1="100" y1="52" x2="100" y2="36"/>
        <line x1="130" y1="60" x2="141" y2="48"/>
        <line x1="148" y1="88" x2="164" y2="85"/>
        <line x1="136" y1="116" x2="148" y2="126"/>
        <line x1="70"  y1="60" x2="59"  y2="48"/>
        <line x1="52"  y1="88" x2="36"  y2="85"/>
        <line x1="64"  y1="116" x2="52" y2="126"/>
      </g>
      <path d="M12 172 L12 128 Q55 112 96 116 L96 160 Q54 156 12 172Z" fill="#1B7B52"/>
      <path d="M104 116 Q146 112 188 128 L188 172 Q146 156 104 160Z" fill="#1B7B52"/>
      <path d="M96 116 Q56 120 16 134 L16 166 Q56 152 96 156Z" fill="#EFF8EF"/>
      <path d="M104 116 L104 156 Q144 152 184 166 L184 134 Q144 120 104 116Z" fill="#EFF8EF"/>
      <path d="M96 116 Q100 114 104 116 L104 160 Q100 162 96 160Z" fill="#155E3E"/>
      <path d="M12 168 Q100 185 188 168 L188 175 Q100 193 12 175Z" fill="#155E3E"/>
      <path d="M185 126 L192 126 L192 148 L188.5 144 L185 148Z" fill="#155E3E"/>
      <circle cx="100" cy="90" r="32" fill="#E63027"/>
    </svg>
    <span class="nav-logo-text">Transia <span>Career</span></span>
  </a>

  <ul class="nav-links">
    {links.map(l => (
      <li>
        <a href={l.href} class={activePage === l.key ? 'active' : ''}>
          {l.label}
        </a>
      </li>
    ))}
    <li><a href="https://lms.transiacareer.id" target="_blank" rel="noopener" class="nav-lms">🎓 LMS</a></li>
    <li><a href="/daftar" class="nav-cta">✍️ Daftar</a></li>
  </ul>

  <button class="hamburger" onclick="toggleMobile()" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>

<div class="mobile-menu" id="mobileMenu">
  {links.map(l => <a href={l.href}>{l.label}</a>)}
  <a href="https://lms.transiacareer.id" target="_blank" rel="noopener">🎓 Masuk LMS</a>
  <a href="/daftar" style="color: var(--red); font-weight: 700;">✍️ Daftar Sekarang</a>
</div>
